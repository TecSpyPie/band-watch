1 ICON "bandwatch.ico"
1 VERSIONINFO
FILEVERSION @MA@,@MI@,@PA@,0
PRODUCTVERSION @MA@,@MI@,@PA@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904B0"
    BEGIN
      VALUE "CompanyName", "M3VRV & King Coder"
      VALUE "FileDescription", "Band Watch by M3VRV & King Coder"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "BandWatch"
      VALUE "OriginalFilename", "BandWatch.exe"
      VALUE "ProductName", "Band Watch by M3VRV & King Coder"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "LegalCopyright", "Copyright (c) 2026 M3VRV"
      VALUE "Comments", "Built @BUILD@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
